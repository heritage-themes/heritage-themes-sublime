{
  "extends": "Adaptive.sublime-theme",
  "variables": {
    "sheet_dark_modifier": "blend(#34271E 70%)",
    "sheet_medium_dark_modifier": "blend(#34271E 70%)",
    "sheet_medium_modifier": "blend(#34271E 70%)",
    "sheet_light_modifier": "blend(#34271E 70%)",
    "text_widget_dark_modifier": "blend(#34271E 70%)",
    "text_widget_light_modifier": "blend(#34271E 70%)"
  },
