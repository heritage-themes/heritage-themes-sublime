    {
      "class": "title_bar",
      "settings": [
        "themed_title_bar"
      ],
      "bg": "#34271E",
      "fg": "#AC9F90",
      "style": "dark"
    },
    {
      "class": "tabset_control",
      "settings": {
        "file_tab_style": [
          "",
          "rounded",
          "square"
        ]
      },
      "layer0.tint": "#34271E"
    },
    {
      "class": "tab_control",
      "settings": {
        "file_tab_style": [
          "",
          "rounded",
          "square"
        ]
      },
      "layer0.tint": "#34271E"
    },
    {
      "class": "tabset_control",
      "settings": {
        "file_tab_style": "angled"
      },
      "tint_modifier": "#34271E"
    },
    {
      "class": "tab_label",
      "fg": "#9B8E7E",
      "opacity": 1.0
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "hover"
          ]
        }
      ],
      "fg": "#AC9F90"
    },
    {
      "class": "tab_label",
      "parents": [
        {
