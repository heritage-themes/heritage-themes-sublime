{
  "extends": "Adaptive.sublime-theme",
  "variables": {
    "sheet_dark_modifier": "blend(#1B2738 70%)",
    "sheet_medium_dark_modifier": "blend(#1B2738 70%)",
    "sheet_medium_modifier": "blend(#1B2738 70%)",
    "sheet_light_modifier": "blend(#1B2738 70%)",
    "text_widget_dark_modifier": "blend(#1B2738 70%)",
    "text_widget_light_modifier": "blend(#1B2738 70%)"
  },
  "rules": [
    {
      "class": "title_bar",
      "settings": [
        "themed_title_bar"
      ],
      "bg": "#1B2738",
      "fg": "#A3BED6",
      "style": "dark"
    },
    {
      "class": "tabset_control",
      "settings": {
        "file_tab_style": [
          "",
          "rounded",
          "square"
        ]
      },
      "layer0.tint": "#1B2738"
    },
    {
      "class": "tab_control",
      "settings": {
        "file_tab_style": [
          "",
          "rounded",
          "square"
        ]
      },
      "layer0.tint": "#1B2738"
    },
    {
      "class": "tabset_control",
      "settings": {
        "file_tab_style": "angled"
      },
      "tint_modifier": "#1B2738"
    },
    {
      "class": "tab_label",
      "fg": "#7D8FA2",
      "opacity": 1.0
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "hover"
          ]
        }
      ],
      "fg": "#A3BED6"
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "#A3BED6"
    },
    {
      "class": "grid_layout_control",
      "border_color": "#1B2738"
    },
    {
      "class": "status_bar",
      "layer0.tint": "#1B2738",
      "layer1.tint": "#1F2939"
    },
    {
      "class": "sidebar_container",
      "layer0.tint": "#1B2738",
      "layer0.opacity": 1.0
    },
    {
      "class": "tree_row",
      "attributes": [
        "selectable",
        "hover"
      ],
      "layer0.tint": "#192435",
      "layer0.opacity": 1.0
    },
    {
      "class": "tree_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#1F344E",
      "layer0.opacity": 1.0
    },
    {
      "class": "sidebar_heading",
      "fg": "#7D8FA2",
      "shadow_color": "transparent"
    },
    {
      "class": "sidebar_label",
      "fg": "#A3BED6"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "file_system_entry",
          "attributes": [
            "ignored"
          ]
        }
      ],
      "fg": "#7D8FA2"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "hover"
          ]
        }
      ],
      "fg": "#A3BED6"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "#A3BED6"
    },
    {
      "class": "panel_control",
      "layer0.tint": "#1B2738",
      "layer1.tint": "#1F2939"
    },
    {
      "class": "switch_project_panel_cancel_container",
      "layer0.tint": "#1B2738"
    },
    {
      "class": "label_control",
      "fg": "#A3BED6"
    },
    {
      "class": "label_control",
      "parents": [
        {
          "class": "status_bar"
        }
      ],
      "shadow_color": "transparent"
    },
    {
      "class": "vcs_branch_icon",
      "layer0.tint": "#7D8FA2"
    },
    {
      "class": "vcs_changes_annotation",
      "color": "#7D8FA2",
      "border_color": "#7D8FA2"
    },
    {
      "class": "progress_bar_control",
      "layer0.tint": "#1F2939",
      "layer0.opacity": 1.0
    },
    {
      "class": "progress_gauge_control",
      "layer0.tint": "#2D5786",
      "layer0.opacity": 1.0
    },
    {
      "class": "overlay_control",
      "layer0.tint": "#121C2B"
    },
    {
      "class": "quick_panel",
      "layer0.tint": "#121C2B"
    },
    {
      "class": "quick_panel_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#1F344E",
      "layer0.opacity": 1.0
    },
    {
      "class": "mini_quick_panel_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#1F344E",
      "layer0.opacity": 1.0
    },
    {
      "class": "quick_panel_label",
      "fg": "#A3BED6",
      "match_fg": "#73A9E1",
      "selected_fg": "#A3BED6",
      "selected_match_fg": "#73A9E1"
    },
    {
      "class": "quick_panel_path_label",
      "fg": "#7D8FA2",
      "match_fg": "#73A9E1",
      "selected_fg": "#A3BED6",
      "selected_match_fg": "#73A9E1"
    },
    {
      "class": "quick_panel_label hint",
      "fg": "#7D8FA2",
      "selected_fg": "#A3BED6"
    },
    {
      "class": "auto_complete",
      "tint_modifier": "#121C2B"
    },
    {
      "class": "auto_complete_detail_pane",
      "tint_modifier": "#121C2B"
    },
    {
      "class": "table_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#1F344E",
      "layer0.opacity": 1.0
    },
    {
      "class": "tool_tip_control",
      "layer0.tint": "#121C2B"
    },
    {
      "class": "tool_tip_label_control",
      "fg": "#A3BED6"
    },
    {
      "class": "dialog",
      "layer0.tint": "#121C2B"
    },
    {
      "class": "title_label_control",
      "fg": "#A3BED6"
    },
    {
      "class": "link_label",
      "fg": "#75BFC8"
    }
  ]
}
