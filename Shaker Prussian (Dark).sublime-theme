{
  "extends": "Adaptive.sublime-theme",
  "variables": {
    "sheet_dark_modifier": "blend(#1C2D3C 70%)",
    "sheet_medium_dark_modifier": "blend(#1C2D3C 70%)",
    "sheet_medium_modifier": "blend(#1C2D3C 70%)",
    "sheet_light_modifier": "blend(#1C2D3C 70%)",
    "text_widget_dark_modifier": "blend(#1C2D3C 70%)",
    "text_widget_light_modifier": "blend(#1C2D3C 70%)"
  },
  "rules": [
    {
      "class": "title_bar",
      "settings": [
        "themed_title_bar"
      ],
      "bg": "#1C2D3C",
      "fg": "#B8BEC2",
      "style": "dark"
    },
    {
      "class": "tabset_control",
      "settings": {
        "file_tab_style": [
          "",
          "rounded",
          "square"
        ]
      },
      "layer0.tint": "#1C2D3C"
    },
    {
      "class": "tab_control",
      "settings": {
        "file_tab_style": [
          "",
          "rounded",
          "square"
        ]
      },
      "layer0.tint": "#1C2D3C"
    },
    {
      "class": "tabset_control",
      "settings": {
        "file_tab_style": "angled"
      },
      "tint_modifier": "#1C2D3C"
    },
    {
      "class": "tab_label",
      "fg": "#909AA2",
      "opacity": 1.0
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "hover"
          ]
        }
      ],
      "fg": "#B8BEC2"
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "#B8BEC2"
    },
    {
      "class": "grid_layout_control",
      "border_color": "#1C2D3C"
    },
    {
      "class": "status_bar",
      "layer0.tint": "#1C2D3C",
      "layer1.tint": "#283A4C"
    },
    {
      "class": "sidebar_container",
      "layer0.tint": "#1C2D3C",
      "layer0.opacity": 1.0
    },
    {
      "class": "tree_row",
      "attributes": [
        "selectable",
        "hover"
      ],
      "layer0.tint": "#1F3040",
      "layer0.opacity": 1.0
    },
    {
      "class": "tree_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#2A4258",
      "layer0.opacity": 1.0
    },
    {
      "class": "sidebar_heading",
      "fg": "#909AA2",
      "shadow_color": "transparent"
    },
    {
      "class": "sidebar_label",
      "fg": "#B8BEC2"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "file_system_entry",
          "attributes": [
            "ignored"
          ]
        }
      ],
      "fg": "#909AA2"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "hover"
          ]
        }
      ],
      "fg": "#B8BEC2"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "#B8BEC2"
    },
    {
      "class": "panel_control",
      "layer0.tint": "#1C2D3C",
      "layer1.tint": "#283A4C"
    },
    {
      "class": "switch_project_panel_cancel_container",
      "layer0.tint": "#1C2D3C"
    },
    {
      "class": "label_control",
      "fg": "#B8BEC2"
    },
    {
      "class": "label_control",
      "parents": [
        {
          "class": "status_bar"
        }
      ],
      "shadow_color": "transparent"
    },
    {
      "class": "vcs_branch_icon",
      "layer0.tint": "#909AA2"
    },
    {
      "class": "vcs_changes_annotation",
      "color": "#909AA2",
      "border_color": "#909AA2"
    },
    {
      "class": "progress_bar_control",
      "layer0.tint": "#283A4C",
      "layer0.opacity": 1.0
    },
    {
      "class": "progress_gauge_control",
      "layer0.tint": "#B23A2A",
      "layer0.opacity": 1.0
    },
    {
      "class": "overlay_control",
      "layer0.tint": "#172634"
    },
    {
      "class": "quick_panel",
      "layer0.tint": "#172634"
    },
    {
      "class": "quick_panel_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#2A4258",
      "layer0.opacity": 1.0
    },
    {
      "class": "mini_quick_panel_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#2A4258",
      "layer0.opacity": 1.0
    },
    {
      "class": "quick_panel_label",
      "fg": "#B8BEC2",
      "match_fg": "#82AEF0",
      "selected_fg": "#B8BEC2",
      "selected_match_fg": "#82AEF0"
    },
    {
      "class": "quick_panel_path_label",
      "fg": "#909AA2",
      "match_fg": "#82AEF0",
      "selected_fg": "#B8BEC2",
      "selected_match_fg": "#82AEF0"
    },
    {
      "class": "quick_panel_label hint",
      "fg": "#909AA2",
      "selected_fg": "#B8BEC2"
    },
    {
      "class": "auto_complete",
      "tint_modifier": "#172634"
    },
    {
      "class": "auto_complete_detail_pane",
      "tint_modifier": "#172634"
    },
    {
      "class": "table_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#2A4258",
      "layer0.opacity": 1.0
    },
    {
      "class": "tool_tip_control",
      "layer0.tint": "#172634"
    },
    {
      "class": "tool_tip_label_control",
      "fg": "#B8BEC2"
    },
    {
      "class": "dialog",
      "layer0.tint": "#172634"
    },
    {
      "class": "title_label_control",
      "fg": "#B8BEC2"
    },
    {
      "class": "link_label",
      "fg": "#8AB4E0"
    }
  ]
}
