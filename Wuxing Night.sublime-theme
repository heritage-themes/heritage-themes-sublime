{
  "extends": "Adaptive.sublime-theme",
  "variables": {
    "sheet_dark_modifier": "blend(#252B3D 70%)",
    "sheet_medium_dark_modifier": "blend(#252B3D 70%)",
    "sheet_medium_modifier": "blend(#252B3D 70%)",
    "sheet_light_modifier": "blend(#252B3D 70%)",
    "text_widget_dark_modifier": "blend(#252B3D 70%)",
    "text_widget_light_modifier": "blend(#252B3D 70%)"
  },
  "rules": [
    {
      "class": "title_bar",
      "settings": [
        "themed_title_bar"
      ],
      "bg": "#252B3D",
      "fg": "#E6DCC8",
      "style": "dark"
    },
    {
      "class": "tabset_control",
      "settings": {
        "file_tab_style": [
          "",
          "rounded",
          "square"
        ]
      },
      "layer0.tint": "#252B3D"
    },
    {
      "class": "tab_control",
      "settings": {
        "file_tab_style": [
          "",
          "rounded",
          "square"
        ]
      },
      "layer0.tint": "#252B3D"
    },
    {
      "class": "tabset_control",
      "settings": {
        "file_tab_style": "angled"
      },
      "tint_modifier": "#252B3D"
    },
    {
      "class": "tab_label",
      "fg": "#979284",
      "opacity": 1.0
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "hover"
          ]
        }
      ],
      "fg": "#E6DCC8"
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "#E6DCC8"
    },
    {
      "class": "grid_layout_control",
      "border_color": "#252B3D"
    },
    {
      "class": "status_bar",
      "layer0.tint": "#252B3D",
      "layer1.tint": "#262C3D"
    },
    {
      "class": "sidebar_container",
      "layer0.tint": "#252B3D",
      "layer0.opacity": 1.0
    },
    {
      "class": "tree_row",
      "attributes": [
        "selectable",
        "hover"
      ],
      "layer0.tint": "#242A3B",
      "layer0.opacity": 1.0
    },
    {
      "class": "tree_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#2D3754",
      "layer0.opacity": 1.0
