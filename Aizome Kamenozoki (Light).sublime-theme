            "ignored"
          ]
        }
      ],
      "fg": "#4B5E73"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "hover"
          ]
        }
      ],
      "fg": "#213651"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "#213651"
    },
    {
      "class": "panel_control",
      "layer0.tint": "#C8D8E0",
      "layer1.tint": "#C3D4DD"
    },
    {
      "class": "switch_project_panel_cancel_container",
      "layer0.tint": "#C8D8E0"
    },
    {
      "class": "label_control",
      "fg": "#213651"
    },
    {
      "class": "label_control",
      "parents": [
        {
          "class": "status_bar"
        }
      ],
      "shadow_color": "transparent"
    },
    {
      "class": "vcs_branch_icon",
