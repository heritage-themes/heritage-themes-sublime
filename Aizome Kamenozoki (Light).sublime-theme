    {
      "class": "quick_panel_path_label",
      "fg": "#4B5E73",
      "match_fg": "#255691",
      "selected_fg": "#213651",
      "selected_match_fg": "#255691"
    },
    {
      "class": "quick_panel_label hint",
      "fg": "#4B5E73",
      "selected_fg": "#213651"
    },
    {
      "class": "auto_complete",
      "tint_modifier": "#F1F8FB"
