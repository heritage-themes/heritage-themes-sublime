    },
    {
      "class": "vcs_changes_annotation",
      "color": "#4B5E73",
      "border_color": "#4B5E73"
    },
    {
      "class": "progress_bar_control",
      "layer0.tint": "#C3D4DD",
      "layer0.opacity": 1.0
    },
    {
      "class": "progress_gauge_control",
      "layer0.tint": "#23436C",
      "layer0.opacity": 1.0
    },
    {
      "class": "overlay_control",
      "layer0.tint": "#F1F8FB"
