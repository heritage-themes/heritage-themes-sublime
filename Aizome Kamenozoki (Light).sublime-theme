{
  "extends": "Adaptive.sublime-theme",
  "variables": {
    "sheet_dark_modifier": "blend(#C8D8E0 70%)",
    "sheet_medium_dark_modifier": "blend(#C8D8E0 70%)",
    "sheet_medium_modifier": "blend(#C8D8E0 70%)",
    "sheet_light_modifier": "blend(#C8D8E0 70%)",
    "text_widget_dark_modifier": "blend(#C8D8E0 70%)",
    "text_widget_light_modifier": "blend(#C8D8E0 70%)"
  },
  "rules": [
    {
      "class": "title_bar",
      "settings": [
        "themed_title_bar"
      ],
      "bg": "#C8D8E0",
      "fg": "#213651",
      "style": "light"
    },
    {
      "class": "tabset_control",
      "settings": {
        "file_tab_style": [
          "",
          "rounded",
          "square"
        ]
      },
      "layer0.tint": "#C8D8E0"
    },
    {
      "class": "tab_control",
      "settings": {
        "file_tab_style": [
          "",
          "rounded",
          "square"
        ]
      },
      "layer0.tint": "#C8D8E0"
    },
    {
      "class": "tabset_control",
      "settings": {
        "file_tab_style": "angled"
      },
      "tint_modifier": "#C8D8E0"
    },
    {
      "class": "tab_label",
      "fg": "#4B5E73",
      "opacity": 1.0
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "hover"
          ]
        }
      ],
      "fg": "#213651"
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "#213651"
    },
    {
      "class": "grid_layout_control",
      "border_color": "#C8D8E0"
    },
    {
      "class": "status_bar",
      "layer0.tint": "#C8D8E0",
      "layer1.tint": "#C3D4DD"
    },
    {
      "class": "sidebar_container",
      "layer0.tint": "#C8D8E0",
      "layer0.opacity": 1.0
    },
    {
      "class": "tree_row",
      "attributes": [
        "selectable",
        "hover"
      ],
      "layer0.tint": "#D0DFE7",
      "layer0.opacity": 1.0
    },
    {
      "class": "tree_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#BDD8EC",
      "layer0.opacity": 1.0
    },
    {
      "class": "sidebar_heading",
      "fg": "#4B5E73",
      "shadow_color": "transparent"
