    {
      "class": "auto_complete_detail_pane",
      "tint_modifier": "#F1F8FB"
    },
    {
      "class": "table_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#BDD8EC",
      "layer0.opacity": 1.0
    },
    {
      "class": "tool_tip_control",
      "layer0.tint": "#F1F8FB"
    },
    {
      "class": "tool_tip_label_control",
      "fg": "#213651"
    },
    {
      "class": "dialog",
      "layer0.tint": "#F1F8FB"
    },
    {
      "class": "title_label_control",
      "fg": "#213651"
    },
    {
      "class": "link_label",
      "fg": "#186575"
    }
  ]
