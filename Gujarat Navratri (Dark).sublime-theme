    {
      "class": "quick_panel_label",
      "fg": "#F2ECE4",
      "match_fg": "#6FB8F5",
      "selected_fg": "#F2ECE4",
      "selected_match_fg": "#6FB8F5"
    },
    {
      "class": "quick_panel_path_label",
      "fg": "#938B9C",
      "match_fg": "#6FB8F5",
      "selected_fg": "#F2ECE4",
      "selected_match_fg": "#6FB8F5"
    },
    {
      "class": "quick_panel_label hint",
      "fg": "#938B9C",
      "selected_fg": "#F2ECE4"
    },
    {
      "class": "auto_complete",
      "tint_modifier": "#211B2A"
    },
    {
      "class": "auto_complete_detail_pane",
      "tint_modifier": "#211B2A"
    },
    {
      "class": "table_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#382E4C",
      "layer0.opacity": 1.0
    },
    {
      "class": "tool_tip_control",
      "layer0.tint": "#211B2A"
    },
    {
      "class": "tool_tip_label_control",
      "fg": "#F2ECE4"
    },
    {
      "class": "dialog",
      "layer0.tint": "#211B2A"
    },
    {
      "class": "title_label_control",
      "fg": "#F2ECE4"
    },
    {
      "class": "link_label",
      "fg": "#6FB8F5"
    }
  ]
}
