{
  "extends": "Adaptive.sublime-theme",
  "variables": {
    "sheet_dark_modifier": "blend(#1C3127 70%)",
    "sheet_medium_dark_modifier": "blend(#1C3127 70%)",
    "sheet_medium_modifier": "blend(#1C3127 70%)",
    "sheet_light_modifier": "blend(#1C3127 70%)",
    "text_widget_dark_modifier": "blend(#1C3127 70%)",
    "text_widget_light_modifier": "blend(#1C3127 70%)"
  },
  "rules": [
    {
      "class": "title_bar",
      "settings": [
        "themed_title_bar"
      ],
      "bg": "#1C3127",
      "fg": "#C6CBC4",
      "style": "dark"
    },
    {
      "class": "tabset_control",
      "settings": {
        "file_tab_style": [
          "",
          "rounded",
          "square"
        ]
      },
      "layer0.tint": "#1C3127"
    },
    {
      "class": "tab_control",
      "settings": {
        "file_tab_style": [
          "",
          "rounded",
          "square"
        ]
      },
      "layer0.tint": "#1C3127"
    },
    {
      "class": "tabset_control",
      "settings": {
        "file_tab_style": "angled"
      },
      "tint_modifier": "#1C3127"
    },
    {
      "class": "tab_label",
      "fg": "#89978F",
      "opacity": 1.0
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "hover"
          ]
        }
      ],
      "fg": "#C6CBC4"
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "#C6CBC4"
    },
    {
      "class": "grid_layout_control",
      "border_color": "#1C3127"
    },
    {
      "class": "status_bar",
      "layer0.tint": "#1C3127",
      "layer1.tint": "#243A30"
    },
    {
      "class": "sidebar_container",
      "layer0.tint": "#1C3127",
      "layer0.opacity": 1.0
    },
    {
      "class": "tree_row",
      "attributes": [
        "selectable",
        "hover"
      ],
      "layer0.tint": "#1F332A",
      "layer0.opacity": 1.0
    },
    {
      "class": "tree_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#24403A",
      "layer0.opacity": 1.0
