    {
      "class": "tool_tip_control",
      "layer0.tint": "#172A22"
    },
    {
      "class": "tool_tip_label_control",
      "fg": "#C6CBC4"
    },
    {
      "class": "dialog",
      "layer0.tint": "#172A22"
    },
    {
      "class": "title_label_control",
      "fg": "#C6CBC4"
    },
    {
      "class": "link_label",
      "fg": "#A9C2EC"
    }
