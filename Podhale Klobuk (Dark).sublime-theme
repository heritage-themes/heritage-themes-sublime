{
  "extends": "Adaptive.sublime-theme",
  "variables": {
    "sheet_dark_modifier": "blend(#2A2622 70%)",
    "sheet_medium_dark_modifier": "blend(#2A2622 70%)",
    "sheet_medium_modifier": "blend(#2A2622 70%)",
    "sheet_light_modifier": "blend(#2A2622 70%)",
    "text_widget_dark_modifier": "blend(#2A2622 70%)",
    "text_widget_light_modifier": "blend(#2A2622 70%)"
  },
  "rules": [
    {
      "class": "title_bar",
      "settings": [
        "themed_title_bar"
      ],
      "bg": "#2A2622",
      "fg": "#ECE5D8",
      "style": "dark"
    },
    {
      "class": "tabset_control",
      "settings": {
        "file_tab_style": [
          "",
          "rounded",
          "square"
        ]
      },
      "layer0.tint": "#2A2622"
    },
    {
      "class": "tab_control",
      "settings": {
        "file_tab_style": [
          "",
          "rounded",
          "square"
        ]
      },
      "layer0.tint": "#2A2622"
    },
    {
      "class": "tabset_control",
      "settings": {
        "file_tab_style": "angled"
      },
      "tint_modifier": "#2A2622"
    },
    {
      "class": "tab_label",
      "fg": "#968E82",
      "opacity": 1.0
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "hover"
          ]
        }
      ],
      "fg": "#ECE5D8"
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "#ECE5D8"
    },
    {
      "class": "grid_layout_control",
      "border_color": "#2A2622"
    },
    {
      "class": "status_bar",
      "layer0.tint": "#2A2622",
      "layer1.tint": "#302B28"
    },
    {
      "class": "sidebar_container",
      "layer0.tint": "#2A2622",
      "layer0.opacity": 1.0
    },
    {
      "class": "tree_row",
      "attributes": [
        "selectable",
        "hover"
      ],
      "layer0.tint": "#292522",
      "layer0.opacity": 1.0
    },
    {
      "class": "tree_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#3E2228",
      "layer0.opacity": 1.0
    },
    {
      "class": "sidebar_heading",
      "fg": "#968E82",
      "shadow_color": "transparent"
    },
    {
      "class": "sidebar_label",
      "fg": "#ECE5D8"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "file_system_entry",
          "attributes": [
            "ignored"
          ]
        }
      ],
      "fg": "#968E82"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "hover"
          ]
        }
      ],
      "fg": "#ECE5D8"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "#ECE5D8"
    },
    {
      "class": "panel_control",
      "layer0.tint": "#2A2622",
      "layer1.tint": "#302B28"
    },
    {
      "class": "switch_project_panel_cancel_container",
      "layer0.tint": "#2A2622"
    },
    {
      "class": "label_control",
      "fg": "#ECE5D8"
    },
    {
      "class": "label_control",
      "parents": [
        {
          "class": "status_bar"
        }
      ],
      "shadow_color": "transparent"
    },
    {
      "class": "vcs_branch_icon",
      "layer0.tint": "#968E82"
    },
    {
      "class": "vcs_changes_annotation",
      "color": "#968E82",
      "border_color": "#968E82"
    },
    {
      "class": "progress_bar_control",
      "layer0.tint": "#302B28",
      "layer0.opacity": 1.0
    },
    {
      "class": "progress_gauge_control",
      "layer0.tint": "#B01E38",
      "layer0.opacity": 1.0
    },
    {
      "class": "overlay_control",
      "layer0.tint": "#1F1C1A"
    },
    {
      "class": "quick_panel",
      "layer0.tint": "#1F1C1A"
    },
    {
      "class": "quick_panel_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#3E2228",
      "layer0.opacity": 1.0
    },
    {
      "class": "mini_quick_panel_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#3E2228",
      "layer0.opacity": 1.0
    },
    {
      "class": "quick_panel_label",
      "fg": "#ECE5D8",
      "match_fg": "#7FB0F5",
      "selected_fg": "#ECE5D8",
      "selected_match_fg": "#7FB0F5"
    },
    {
      "class": "quick_panel_path_label",
      "fg": "#968E82",
      "match_fg": "#7FB0F5",
      "selected_fg": "#ECE5D8",
      "selected_match_fg": "#7FB0F5"
    },
    {
      "class": "quick_panel_label hint",
      "fg": "#968E82",
      "selected_fg": "#ECE5D8"
    },
    {
      "class": "auto_complete",
      "tint_modifier": "#1F1C1A"
    },
    {
      "class": "auto_complete_detail_pane",
      "tint_modifier": "#1F1C1A"
    },
    {
      "class": "table_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#3E2228",
      "layer0.opacity": 1.0
    },
    {
      "class": "tool_tip_control",
      "layer0.tint": "#1F1C1A"
    },
    {
      "class": "tool_tip_label_control",
      "fg": "#ECE5D8"
    },
    {
      "class": "dialog",
      "layer0.tint": "#1F1C1A"
    },
    {
      "class": "title_label_control",
      "fg": "#ECE5D8"
    },
    {
      "class": "link_label",
      "fg": "#93A6EE"
    }
  ]
}
