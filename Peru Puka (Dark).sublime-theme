            "ignored"
          ]
        }
      ],
      "fg": "#D8A8B9"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "hover"
          ]
        }
      ],
      "fg": "#F8ECE0"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "#F8ECE0"
    },
    {
      "class": "panel_control",
      "layer0.tint": "#83164F",
      "layer1.tint": "#89365B"
    },
    {
      "class": "switch_project_panel_cancel_container",
      "layer0.tint": "#83164F"
    },
    {
      "class": "label_control",
      "fg": "#F8ECE0"
    },
    {
      "class": "label_control",
      "parents": [
        {
          "class": "status_bar"
        }
      ],
      "shadow_color": "transparent"
    },
    {
      "class": "vcs_branch_icon",
      "layer0.tint": "#D8A8B9"
    },
    {
      "class": "vcs_changes_annotation",
      "color": "#D8A8B9",
      "border_color": "#D8A8B9"
    },
    {
      "class": "progress_bar_control",
      "layer0.tint": "#89365B",
      "layer0.opacity": 1.0
    },
    {
      "class": "progress_gauge_control",
      "layer0.tint": "#97ED9A",
      "layer0.opacity": 1.0
    },
    {
      "class": "overlay_control",
      "layer0.tint": "#7F124C"
    },
    {
      "class": "quick_panel",
      "layer0.tint": "#7F124C"
    },
    {
      "class": "quick_panel_row",
      "attributes": [
        "selected"
      ],
