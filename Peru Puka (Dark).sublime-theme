    {
      "class": "quick_panel_path_label",
      "fg": "#D8A8B9",
      "match_fg": "#92C9FF",
      "selected_fg": "#F8ECE0",
      "selected_match_fg": "#92C9FF"
    },
    {
      "class": "quick_panel_label hint",
      "fg": "#D8A8B9",
      "selected_fg": "#F8ECE0"
    },
    {
      "class": "auto_complete",
      "tint_modifier": "#7F124C"
    },
    {
      "class": "auto_complete_detail_pane",
      "tint_modifier": "#7F124C"
    },
    {
      "class": "table_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#414F7F",
      "layer0.opacity": 1.0
    },
    {
      "class": "tool_tip_control",
      "layer0.tint": "#7F124C"
    },
    {
      "class": "tool_tip_label_control",
      "fg": "#F8ECE0"
    },
    {
      "class": "dialog",
      "layer0.tint": "#7F124C"
    },
    {
      "class": "title_label_control",
      "fg": "#F8ECE0"
    },
    {
      "class": "link_label",
      "fg": "#99D1FF"
    }
  ]
