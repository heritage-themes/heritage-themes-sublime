{
  "extends": "Adaptive.sublime-theme",
  "variables": {
    "sheet_dark_modifier": "blend(#83164F 70%)",
    "sheet_medium_dark_modifier": "blend(#83164F 70%)",
    "sheet_medium_modifier": "blend(#83164F 70%)",
    "sheet_light_modifier": "blend(#83164F 70%)",
    "text_widget_dark_modifier": "blend(#83164F 70%)",
    "text_widget_light_modifier": "blend(#83164F 70%)"
  },
  "rules": [
    {
      "class": "title_bar",
      "settings": [
        "themed_title_bar"
      ],
      "bg": "#83164F",
      "fg": "#F8ECE0",
      "style": "dark"
    },
    {
      "class": "tabset_control",
      "settings": {
        "file_tab_style": [
          "",
          "rounded",
          "square"
        ]
      },
      "layer0.tint": "#83164F"
    },
    {
      "class": "tab_control",
      "settings": {
        "file_tab_style": [
          "",
          "rounded",
          "square"
        ]
      },
      "layer0.tint": "#83164F"
    },
    {
      "class": "tabset_control",
      "settings": {
        "file_tab_style": "angled"
      },
      "tint_modifier": "#83164F"
    },
    {
      "class": "tab_label",
      "fg": "#D8A8B9",
      "opacity": 1.0
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "hover"
          ]
        }
      ],
      "fg": "#F8ECE0"
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "#F8ECE0"
    },
    {
      "class": "grid_layout_control",
      "border_color": "#83164F"
    },
    {
      "class": "status_bar",
      "layer0.tint": "#83164F",
      "layer1.tint": "#89365B"
    },
    {
      "class": "sidebar_container",
      "layer0.tint": "#83164F",
      "layer0.opacity": 1.0
    },
    {
      "class": "tree_row",
      "attributes": [
        "selectable",
        "hover"
      ],
      "layer0.tint": "#8A2656",
      "layer0.opacity": 1.0
    },
    {
      "class": "tree_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#414F7F",
      "layer0.opacity": 1.0
    },
    {
      "class": "sidebar_heading",
      "fg": "#D8A8B9",
      "shadow_color": "transparent"
    },
    {
      "class": "sidebar_label",
      "fg": "#F8ECE0"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "file_system_entry",
