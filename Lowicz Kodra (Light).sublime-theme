{
  "extends": "Adaptive.sublime-theme",
  "variables": {
    "sheet_dark_modifier": "blend(#DEDAD2 70%)",
    "sheet_medium_dark_modifier": "blend(#DEDAD2 70%)",
    "sheet_medium_modifier": "blend(#DEDAD2 70%)",
    "sheet_light_modifier": "blend(#DEDAD2 70%)",
    "text_widget_dark_modifier": "blend(#DEDAD2 70%)",
    "text_widget_light_modifier": "blend(#DEDAD2 70%)"
  },
  "rules": [
    {
      "class": "title_bar",
      "settings": [
        "themed_title_bar"
      ],
      "bg": "#DEDAD2",
      "fg": "#1E1D1B",
      "style": "light"
    },
    {
      "class": "tabset_control",
      "settings": {
        "file_tab_style": [
          "",
          "rounded",
          "square"
        ]
      },
      "layer0.tint": "#DEDAD2"
    },
    {
      "class": "tab_control",
      "settings": {
        "file_tab_style": [
          "",
          "rounded",
          "square"
        ]
      },
      "layer0.tint": "#DEDAD2"
    },
    {
      "class": "tabset_control",
      "settings": {
        "file_tab_style": "angled"
      },
      "tint_modifier": "#DEDAD2"
    },
    {
      "class": "tab_label",
      "fg": "#635F59",
      "opacity": 1.0
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "hover"
          ]
        }
      ],
      "fg": "#1E1D1B"
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "#1E1D1B"
    },
    {
      "class": "grid_layout_control",
      "border_color": "#DEDAD2"
    },
    {
      "class": "status_bar",
      "layer0.tint": "#DEDAD2",
      "layer1.tint": "#D8D4CA"
    },
    {
      "class": "sidebar_container",
      "layer0.tint": "#DEDAD2",
      "layer0.opacity": 1.0
    },
    {
      "class": "tree_row",
      "attributes": [
        "selectable",
        "hover"
      ],
      "layer0.tint": "#E4E1D9",
      "layer0.opacity": 1.0
    },
    {
      "class": "tree_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#F3DDC6",
      "layer0.opacity": 1.0
    },
    {
      "class": "sidebar_heading",
      "fg": "#635F59",
      "shadow_color": "transparent"
    },
    {
      "class": "sidebar_label",
      "fg": "#1E1D1B"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "file_system_entry",
          "attributes": [
            "ignored"
          ]
        }
      ],
      "fg": "#635F59"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "hover"
          ]
        }
      ],
      "fg": "#1E1D1B"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "#1E1D1B"
    },
    {
      "class": "panel_control",
      "layer0.tint": "#DEDAD2",
      "layer1.tint": "#D8D4CA"
    },
    {
      "class": "switch_project_panel_cancel_container",
      "layer0.tint": "#DEDAD2"
    },
    {
      "class": "label_control",
      "fg": "#1E1D1B"
    },
    {
      "class": "label_control",
      "parents": [
        {
          "class": "status_bar"
        }
      ],
      "shadow_color": "transparent"
    },
    {
      "class": "vcs_branch_icon",
      "layer0.tint": "#635F59"
    },
    {
      "class": "vcs_changes_annotation",
      "color": "#635F59",
      "border_color": "#635F59"
    },
    {
      "class": "progress_bar_control",
      "layer0.tint": "#D8D4CA",
      "layer0.opacity": 1.0
    },
    {
      "class": "progress_gauge_control",
      "layer0.tint": "#B04A00",
      "layer0.opacity": 1.0
    },
    {
      "class": "overlay_control",
      "layer0.tint": "#FDFCFA"
    },
    {
      "class": "quick_panel",
      "layer0.tint": "#FDFCFA"
    },
    {
      "class": "quick_panel_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#F3DDC6",
      "layer0.opacity": 1.0
    },
    {
      "class": "mini_quick_panel_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#F3DDC6",
      "layer0.opacity": 1.0
    },
    {
      "class": "quick_panel_label",
      "fg": "#1E1D1B",
      "match_fg": "#1F55A8",
      "selected_fg": "#1E1D1B",
      "selected_match_fg": "#1F55A8"
    },
    {
      "class": "quick_panel_path_label",
      "fg": "#635F59",
      "match_fg": "#1F55A8",
      "selected_fg": "#1E1D1B",
      "selected_match_fg": "#1F55A8"
    },
    {
      "class": "quick_panel_label hint",
      "fg": "#635F59",
      "selected_fg": "#1E1D1B"
    },
    {
      "class": "auto_complete",
      "tint_modifier": "#FDFCFA"
    },
    {
      "class": "auto_complete_detail_pane",
      "tint_modifier": "#FDFCFA"
    },
    {
      "class": "table_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#F3DDC6",
      "layer0.opacity": 1.0
    },
    {
      "class": "tool_tip_control",
      "layer0.tint": "#FDFCFA"
    },
    {
      "class": "tool_tip_label_control",
      "fg": "#1E1D1B"
    },
    {
      "class": "dialog",
      "layer0.tint": "#FDFCFA"
    },
    {
      "class": "title_label_control",
      "fg": "#1E1D1B"
    },
    {
      "class": "link_label",
      "fg": "#1F64B4"
    }
  ]
}
