{
  "extends": "Adaptive.sublime-theme",
  "variables": {
    "sheet_dark_modifier": "blend(#1F364D 70%)",
    "sheet_medium_dark_modifier": "blend(#1F364D 70%)",
    "sheet_medium_modifier": "blend(#1F364D 70%)",
    "sheet_light_modifier": "blend(#1F364D 70%)",
    "text_widget_dark_modifier": "blend(#1F364D 70%)",
    "text_widget_light_modifier": "blend(#1F364D 70%)"
  },
  "rules": [
    {
      "class": "title_bar",
      "settings": [
        "themed_title_bar"
      ],
      "bg": "#1F364D",
      "fg": "#F2EADF",
      "style": "dark"
    },
    {
      "class": "tabset_control",
      "settings": {
        "file_tab_style": [
          "",
          "rounded",
          "square"
        ]
      },
      "layer0.tint": "#1F364D"
    },
    {
      "class": "tab_control",
      "settings": {
        "file_tab_style": [
          "",
          "rounded",
          "square"
        ]
      },
      "layer0.tint": "#1F364D"
    },
    {
      "class": "tabset_control",
      "settings": {
        "file_tab_style": "angled"
      },
      "tint_modifier": "#1F364D"
    },
    {
      "class": "tab_label",
      "fg": "#939EA7",
      "opacity": 1.0
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "hover"
          ]
        }
      ],
      "fg": "#F2EADF"
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "#F2EADF"
    },
    {
      "class": "grid_layout_control",
      "border_color": "#1F364D"
    },
    {
      "class": "status_bar",
      "layer0.tint": "#1F364D",
      "layer1.tint": "#243E56"
    },
    {
      "class": "sidebar_container",
      "layer0.tint": "#1F364D",
      "layer0.opacity": 1.0
    },
    {
      "class": "tree_row",
      "attributes": [
        "selectable",
        "hover"
      ],
      "layer0.tint": "#223A54",
      "layer0.opacity": 1.0
    },
    {
      "class": "tree_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#2A4458",
      "layer0.opacity": 1.0
    },
    {
      "class": "sidebar_heading",
      "fg": "#939EA7",
      "shadow_color": "transparent"
    },
    {
      "class": "sidebar_label",
      "fg": "#F2EADF"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "file_system_entry",
          "attributes": [
            "ignored"
          ]
        }
      ],
      "fg": "#939EA7"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "hover"
          ]
        }
      ],
      "fg": "#F2EADF"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "#F2EADF"
    },
    {
      "class": "panel_control",
      "layer0.tint": "#1F364D",
      "layer1.tint": "#243E56"
    },
    {
      "class": "switch_project_panel_cancel_container",
      "layer0.tint": "#1F364D"
    },
    {
      "class": "label_control",
      "fg": "#F2EADF"
    },
    {
      "class": "label_control",
      "parents": [
        {
          "class": "status_bar"
        }
      ],
      "shadow_color": "transparent"
    },
    {
      "class": "vcs_branch_icon",
      "layer0.tint": "#939EA7"
    },
    {
      "class": "vcs_changes_annotation",
      "color": "#939EA7",
      "border_color": "#939EA7"
    },
    {
      "class": "progress_bar_control",
      "layer0.tint": "#243E56",
      "layer0.opacity": 1.0
    },
    {
      "class": "progress_gauge_control",
      "layer0.tint": "#B5520F",
      "layer0.opacity": 1.0
    },
    {
      "class": "overlay_control",
      "layer0.tint": "#1B3148"
    },
    {
      "class": "quick_panel",
      "layer0.tint": "#1B3148"
    },
    {
      "class": "quick_panel_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#2A4458",
      "layer0.opacity": 1.0
    },
    {
      "class": "mini_quick_panel_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#2A4458",
      "layer0.opacity": 1.0
    },
    {
      "class": "quick_panel_label",
      "fg": "#F2EADF",
      "match_fg": "#6CC0FF",
      "selected_fg": "#F2EADF",
      "selected_match_fg": "#6CC0FF"
    },
    {
      "class": "quick_panel_path_label",
      "fg": "#939EA7",
      "match_fg": "#6CC0FF",
      "selected_fg": "#F2EADF",
      "selected_match_fg": "#6CC0FF"
    },
    {
      "class": "quick_panel_label hint",
      "fg": "#939EA7",
      "selected_fg": "#F2EADF"
    },
    {
      "class": "auto_complete",
      "tint_modifier": "#1B3148"
    },
    {
      "class": "auto_complete_detail_pane",
      "tint_modifier": "#1B3148"
    },
    {
      "class": "table_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#2A4458",
      "layer0.opacity": 1.0
    },
    {
      "class": "tool_tip_control",
      "layer0.tint": "#1B3148"
    },
    {
      "class": "tool_tip_label_control",
      "fg": "#F2EADF"
    },
    {
      "class": "dialog",
      "layer0.tint": "#1B3148"
    },
    {
      "class": "title_label_control",
      "fg": "#F2EADF"
    },
    {
      "class": "link_label",
      "fg": "#6CC0FF"
    }
  ]
}
