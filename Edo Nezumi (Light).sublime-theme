    {
      "class": "quick_panel_label",
      "fg": "#3A342F",
      "match_fg": "#23588A",
      "selected_fg": "#3A342F",
      "selected_match_fg": "#23588A"
    },
    {
      "class": "quick_panel_path_label",
      "fg": "#625C56",
      "match_fg": "#23588A",
      "selected_fg": "#3A342F",
      "selected_match_fg": "#23588A"
    },
    {
      "class": "quick_panel_label hint",
      "fg": "#625C56",
      "selected_fg": "#3A342F"
    },
    {
      "class": "auto_complete",
      "tint_modifier": "#F9F6F3"
    },
    {
      "class": "auto_complete_detail_pane",
      "tint_modifier": "#F9F6F3"
    },
    {
      "class": "table_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#C9DAE7",
      "layer0.opacity": 1.0
    },
    {
      "class": "tool_tip_control",
      "layer0.tint": "#F9F6F3"
    },
    {
      "class": "tool_tip_label_control",
      "fg": "#3A342F"
    },
    {
      "class": "dialog",
      "layer0.tint": "#F9F6F3"
    },
    {
      "class": "title_label_control",
      "fg": "#3A342F"
    },
    {
      "class": "link_label",
      "fg": "#2D5A78"
    }
  ]
}
