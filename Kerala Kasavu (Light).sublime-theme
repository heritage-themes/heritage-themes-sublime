{
  "extends": "Adaptive.sublime-theme",
  "variables": {
    "sheet_dark_modifier": "blend(#E2D9BF 70%)",
    "sheet_medium_dark_modifier": "blend(#E2D9BF 70%)",
    "sheet_medium_modifier": "blend(#E2D9BF 70%)",
    "sheet_light_modifier": "blend(#E2D9BF 70%)",
    "text_widget_dark_modifier": "blend(#E2D9BF 70%)",
    "text_widget_light_modifier": "blend(#E2D9BF 70%)"
  },
  "rules": [
    {
      "class": "title_bar",
      "settings": [
        "themed_title_bar"
      ],
      "bg": "#E2D9BF",
      "fg": "#1F2420",
      "style": "light"
    },
    {
      "class": "tabset_control",
      "settings": {
        "file_tab_style": [
          "",
          "rounded",
          "square"
        ]
      },
      "layer0.tint": "#E2D9BF"
    },
    {
      "class": "tab_control",
      "settings": {
        "file_tab_style": [
          "",
          "rounded",
          "square"
        ]
      },
      "layer0.tint": "#E2D9BF"
    },
    {
      "class": "tabset_control",
      "settings": {
        "file_tab_style": "angled"
      },
      "tint_modifier": "#E2D9BF"
    },
    {
      "class": "tab_label",
      "fg": "#5A615A",
      "opacity": 1.0
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "hover"
          ]
        }
      ],
      "fg": "#1F2420"
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "#1F2420"
    },
    {
      "class": "grid_layout_control",
      "border_color": "#E2D9BF"
    },
    {
      "class": "status_bar",
      "layer0.tint": "#E2D9BF",
      "layer1.tint": "#DACEAC"
    },
    {
      "class": "sidebar_container",
      "layer0.tint": "#E2D9BF",
      "layer0.opacity": 1.0
    },
    {
      "class": "tree_row",
      "attributes": [
        "selectable",
        "hover"
      ],
      "layer0.tint": "#E7DFC6",
      "layer0.opacity": 1.0
    },
    {
      "class": "tree_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#D4E8DA",
      "layer0.opacity": 1.0
    },
    {
      "class": "sidebar_heading",
      "fg": "#5A615A",
      "shadow_color": "transparent"
    },
    {
      "class": "sidebar_label",
      "fg": "#1F2420"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "file_system_entry",
          "attributes": [
            "ignored"
          ]
        }
      ],
      "fg": "#5A615A"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "hover"
          ]
        }
      ],
      "fg": "#1F2420"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "#1F2420"
    },
    {
      "class": "panel_control",
      "layer0.tint": "#E2D9BF",
      "layer1.tint": "#DACEAC"
    },
    {
      "class": "switch_project_panel_cancel_container",
      "layer0.tint": "#E2D9BF"
    },
    {
      "class": "label_control",
      "fg": "#1F2420"
    },
    {
      "class": "label_control",
      "parents": [
        {
          "class": "status_bar"
        }
      ],
      "shadow_color": "transparent"
    },
    {
      "class": "vcs_branch_icon",
      "layer0.tint": "#5A615A"
    },
    {
      "class": "vcs_changes_annotation",
      "color": "#5A615A",
      "border_color": "#5A615A"
    },
    {
      "class": "progress_bar_control",
      "layer0.tint": "#DACEAC",
      "layer0.opacity": 1.0
    },
    {
      "class": "progress_gauge_control",
      "layer0.tint": "#B0203A",
      "layer0.opacity": 1.0
    },
    {
      "class": "overlay_control",
      "layer0.tint": "#FCF9EE"
    },
    {
      "class": "quick_panel",
      "layer0.tint": "#FCF9EE"
    },
    {
      "class": "quick_panel_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#D4E8DA",
      "layer0.opacity": 1.0
    },
    {
      "class": "mini_quick_panel_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#D4E8DA",
      "layer0.opacity": 1.0
