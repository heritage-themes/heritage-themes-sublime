    {
      "class": "quick_panel_label",
      "fg": "#1F2420",
      "match_fg": "#1060A8",
      "selected_fg": "#1F2420",
      "selected_match_fg": "#1060A8"
    },
    {
      "class": "quick_panel_path_label",
      "fg": "#5A615A",
      "match_fg": "#1060A8",
      "selected_fg": "#1F2420",
      "selected_match_fg": "#1060A8"
    },
    {
      "class": "quick_panel_label hint",
      "fg": "#5A615A",
      "selected_fg": "#1F2420"
    },
    {
      "class": "auto_complete",
      "tint_modifier": "#FCF9EE"
    },
    {
      "class": "auto_complete_detail_pane",
      "tint_modifier": "#FCF9EE"
    },
    {
      "class": "table_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#D4E8DA",
      "layer0.opacity": 1.0
    },
    {
      "class": "tool_tip_control",
      "layer0.tint": "#FCF9EE"
    },
    {
      "class": "tool_tip_label_control",
      "fg": "#1F2420"
    },
    {
      "class": "dialog",
      "layer0.tint": "#FCF9EE"
    },
    {
      "class": "title_label_control",
      "fg": "#1F2420"
    },
    {
      "class": "link_label",
      "fg": "#1060A8"
    }
  ]
}
