{
  "extends": "Adaptive.sublime-theme",
  "variables": {
    "sheet_dark_modifier": "blend(#2D2925 70%)",
    "sheet_medium_dark_modifier": "blend(#2D2925 70%)",
    "sheet_medium_modifier": "blend(#2D2925 70%)",
    "sheet_light_modifier": "blend(#2D2925 70%)",
    "text_widget_dark_modifier": "blend(#2D2925 70%)",
    "text_widget_light_modifier": "blend(#2D2925 70%)"
  },
  "rules": [
    {
      "class": "title_bar",
      "settings": [
        "themed_title_bar"
      ],
      "bg": "#2D2925",
      "fg": "#D3CCC1",
      "style": "dark"
    },
    {
      "class": "tabset_control",
      "settings": {
        "file_tab_style": [
          "",
          "rounded",
          "square"
        ]
      },
      "layer0.tint": "#2D2925"
    },
    {
      "class": "tab_control",
      "settings": {
        "file_tab_style": [
          "",
          "rounded",
          "square"
        ]
      },
      "layer0.tint": "#2D2925"
    },
    {
      "class": "tabset_control",
      "settings": {
        "file_tab_style": "angled"
      },
      "tint_modifier": "#2D2925"
    },
    {
      "class": "tab_label",
      "fg": "#988F83",
      "opacity": 1.0
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "hover"
          ]
        }
      ],
      "fg": "#D3CCC1"
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "#D3CCC1"
    },
    {
      "class": "grid_layout_control",
      "border_color": "#2D2925"
    },
    {
      "class": "status_bar",
      "layer0.tint": "#2D2925",
      "layer1.tint": "#34302C"
    },
    {
      "class": "sidebar_container",
      "layer0.tint": "#2D2925",
      "layer0.opacity": 1.0
    },
    {
      "class": "tree_row",
      "attributes": [
        "selectable",
        "hover"
      ],
      "layer0.tint": "#2C2826",
      "layer0.opacity": 1.0
    },
    {
      "class": "tree_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#2C3854",
      "layer0.opacity": 1.0
    },
    {
      "class": "sidebar_heading",
      "fg": "#988F83",
      "shadow_color": "transparent"
    },
    {
      "class": "sidebar_label",
      "fg": "#D3CCC1"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "file_system_entry",
          "attributes": [
            "ignored"
          ]
        }
      ],
      "fg": "#988F83"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "hover"
          ]
        }
      ],
      "fg": "#D3CCC1"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "#D3CCC1"
    },
    {
      "class": "panel_control",
      "layer0.tint": "#2D2925",
      "layer1.tint": "#34302C"
    },
    {
      "class": "switch_project_panel_cancel_container",
      "layer0.tint": "#2D2925"
    },
    {
      "class": "label_control",
      "fg": "#D3CCC1"
    },
    {
      "class": "label_control",
      "parents": [
        {
          "class": "status_bar"
        }
      ],
      "shadow_color": "transparent"
    },
    {
      "class": "vcs_branch_icon",
      "layer0.tint": "#988F83"
    },
    {
      "class": "vcs_changes_annotation",
      "color": "#988F83",
      "border_color": "#988F83"
    },
    {
      "class": "progress_bar_control",
      "layer0.tint": "#34302C",
      "layer0.opacity": 1.0
    },
    {
      "class": "progress_gauge_control",
      "layer0.tint": "#B42A1E",
      "layer0.opacity": 1.0
    },
    {
      "class": "overlay_control",
      "layer0.tint": "#23201E"
    },
    {
      "class": "quick_panel",
      "layer0.tint": "#23201E"
    },
    {
      "class": "quick_panel_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#2C3854",
      "layer0.opacity": 1.0
    },
    {
      "class": "mini_quick_panel_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#2C3854",
      "layer0.opacity": 1.0
    },
    {
      "class": "quick_panel_label",
      "fg": "#D3CCC1",
      "match_fg": "#7FB0F5",
      "selected_fg": "#D3CCC1",
      "selected_match_fg": "#7FB0F5"
    },
    {
      "class": "quick_panel_path_label",
      "fg": "#988F83",
      "match_fg": "#7FB0F5",
      "selected_fg": "#D3CCC1",
      "selected_match_fg": "#7FB0F5"
    },
    {
      "class": "quick_panel_label hint",
      "fg": "#988F83",
      "selected_fg": "#D3CCC1"
    },
    {
      "class": "auto_complete",
      "tint_modifier": "#23201E"
    },
    {
      "class": "auto_complete_detail_pane",
      "tint_modifier": "#23201E"
    },
    {
      "class": "table_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#2C3854",
      "layer0.opacity": 1.0
    },
    {
      "class": "tool_tip_control",
      "layer0.tint": "#23201E"
    },
    {
      "class": "tool_tip_label_control",
      "fg": "#D3CCC1"
    },
    {
      "class": "dialog",
      "layer0.tint": "#23201E"
    },
    {
      "class": "title_label_control",
      "fg": "#D3CCC1"
    },
    {
      "class": "link_label",
      "fg": "#8EADF2"
    }
  ]
}
