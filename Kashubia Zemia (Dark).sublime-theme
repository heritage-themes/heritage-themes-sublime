{
  "extends": "Adaptive.sublime-theme",
  "variables": {
    "sheet_dark_modifier": "blend(#2F2922 70%)",
    "sheet_medium_dark_modifier": "blend(#2F2922 70%)",
    "sheet_medium_modifier": "blend(#2F2922 70%)",
    "sheet_light_modifier": "blend(#2F2922 70%)",
    "text_widget_dark_modifier": "blend(#2F2922 70%)",
    "text_widget_light_modifier": "blend(#2F2922 70%)"
  },
  "rules": [
    {
      "class": "title_bar",
      "settings": [
        "themed_title_bar"
      ],
      "bg": "#2F2922",
      "fg": "#EEE8DC",
      "style": "dark"
    },
    {
      "class": "tabset_control",
      "settings": {
        "file_tab_style": [
          "",
          "rounded",
          "square"
        ]
      },
      "layer0.tint": "#2F2922"
    },
    {
      "class": "tab_control",
      "settings": {
        "file_tab_style": [
          "",
          "rounded",
          "square"
        ]
      },
      "layer0.tint": "#2F2922"
    },
    {
      "class": "tabset_control",
      "settings": {
        "file_tab_style": "angled"
      },
      "tint_modifier": "#2F2922"
    },
    {
      "class": "tab_label",
      "fg": "#9A9184",
      "opacity": 1.0
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "hover"
          ]
        }
      ],
      "fg": "#EEE8DC"
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "#EEE8DC"
    },
    {
      "class": "grid_layout_control",
      "border_color": "#2F2922"
    },
    {
      "class": "status_bar",
      "layer0.tint": "#2F2922",
      "layer1.tint": "#352E27"
    },
    {
      "class": "sidebar_container",
      "layer0.tint": "#2F2922",
      "layer0.opacity": 1.0
    },
    {
      "class": "tree_row",
      "attributes": [
        "selectable",
        "hover"
      ],
      "layer0.tint": "#2E2822",
      "layer0.opacity": 1.0
    },
    {
      "class": "tree_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#263A52",
      "layer0.opacity": 1.0
    },
    {
      "class": "sidebar_heading",
      "fg": "#9A9184",
      "shadow_color": "transparent"
    },
    {
      "class": "sidebar_label",
      "fg": "#EEE8DC"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "file_system_entry",
          "attributes": [
            "ignored"
          ]
        }
      ],
      "fg": "#9A9184"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "hover"
          ]
        }
      ],
      "fg": "#EEE8DC"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "#EEE8DC"
    },
    {
      "class": "panel_control",
      "layer0.tint": "#2F2922",
      "layer1.tint": "#352E27"
    },
    {
      "class": "switch_project_panel_cancel_container",
      "layer0.tint": "#2F2922"
    },
    {
      "class": "label_control",
      "fg": "#EEE8DC"
    },
    {
      "class": "label_control",
      "parents": [
        {
          "class": "status_bar"
        }
      ],
      "shadow_color": "transparent"
    },
    {
      "class": "vcs_branch_icon",
      "layer0.tint": "#9A9184"
    },
    {
      "class": "vcs_changes_annotation",
      "color": "#9A9184",
      "border_color": "#9A9184"
    },
    {
      "class": "progress_bar_control",
      "layer0.tint": "#352E27",
      "layer0.opacity": 1.0
    },
    {
      "class": "progress_gauge_control",
      "layer0.tint": "#3456B8",
      "layer0.opacity": 1.0
    },
    {
      "class": "overlay_control",
      "layer0.tint": "#25201B"
    },
    {
      "class": "quick_panel",
      "layer0.tint": "#25201B"
    },
    {
      "class": "quick_panel_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#263A52",
      "layer0.opacity": 1.0
    },
    {
      "class": "mini_quick_panel_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#263A52",
      "layer0.opacity": 1.0
    },
    {
      "class": "quick_panel_label",
      "fg": "#EEE8DC",
      "match_fg": "#7FB0F5",
      "selected_fg": "#EEE8DC",
      "selected_match_fg": "#7FB0F5"
    },
    {
      "class": "quick_panel_path_label",
      "fg": "#9A9184",
      "match_fg": "#7FB0F5",
      "selected_fg": "#EEE8DC",
      "selected_match_fg": "#7FB0F5"
    },
    {
      "class": "quick_panel_label hint",
      "fg": "#9A9184",
      "selected_fg": "#EEE8DC"
    },
    {
      "class": "auto_complete",
      "tint_modifier": "#25201B"
    },
    {
      "class": "auto_complete_detail_pane",
      "tint_modifier": "#25201B"
    },
    {
      "class": "table_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#263A52",
      "layer0.opacity": 1.0
    },
    {
      "class": "tool_tip_control",
      "layer0.tint": "#25201B"
    },
    {
      "class": "tool_tip_label_control",
      "fg": "#EEE8DC"
    },
    {
      "class": "dialog",
      "layer0.tint": "#25201B"
    },
    {
      "class": "title_label_control",
      "fg": "#EEE8DC"
    },
    {
      "class": "link_label",
      "fg": "#7FB6F0"
    }
  ]
}
