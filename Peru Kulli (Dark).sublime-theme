{
  "extends": "Adaptive.sublime-theme",
  "variables": {
    "sheet_dark_modifier": "blend(#572160 70%)",
    "sheet_medium_dark_modifier": "blend(#572160 70%)",
    "sheet_medium_modifier": "blend(#572160 70%)",
    "sheet_light_modifier": "blend(#572160 70%)",
    "text_widget_dark_modifier": "blend(#572160 70%)",
    "text_widget_light_modifier": "blend(#572160 70%)"
  },
  "rules": [
    {
      "class": "title_bar",
      "settings": [
        "themed_title_bar"
      ],
      "bg": "#572160",
      "fg": "#F8ECE0",
      "style": "dark"
    },
    {
      "class": "tabset_control",
      "settings": {
        "file_tab_style": [
          "",
          "rounded",
          "square"
        ]
      },
      "layer0.tint": "#572160"
    },
    {
      "class": "tab_control",
      "settings": {
        "file_tab_style": [
          "",
          "rounded",
          "square"
        ]
      },
      "layer0.tint": "#572160"
    },
    {
      "class": "tabset_control",
      "settings": {
        "file_tab_style": "angled"
      },
      "tint_modifier": "#572160"
    },
    {
      "class": "tab_label",
      "fg": "#CAABCF",
      "opacity": 1.0
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "hover"
          ]
        }
      ],
      "fg": "#F8ECE0"
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "#F8ECE0"
    },
    {
      "class": "grid_layout_control",
      "border_color": "#572160"
    },
    {
      "class": "status_bar",
      "layer0.tint": "#572160",
      "layer1.tint": "#5F3466"
    },
    {
      "class": "sidebar_container",
      "layer0.tint": "#572160",
      "layer0.opacity": 1.0
    },
    {
      "class": "tree_row",
      "attributes": [
        "selectable",
        "hover"
      ],
      "layer0.tint": "#5D2966",
      "layer0.opacity": 1.0
    },
    {
      "class": "tree_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#374573",
      "layer0.opacity": 1.0
    },
    {
      "class": "sidebar_heading",
      "fg": "#CAABCF",
      "shadow_color": "transparent"
    },
    {
      "class": "sidebar_label",
      "fg": "#F8ECE0"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "file_system_entry",
          "attributes": [
            "ignored"
          ]
        }
      ],
      "fg": "#CAABCF"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "hover"
          ]
        }
      ],
      "fg": "#F8ECE0"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "#F8ECE0"
    },
    {
      "class": "panel_control",
      "layer0.tint": "#572160",
      "layer1.tint": "#5F3466"
    },
    {
      "class": "switch_project_panel_cancel_container",
      "layer0.tint": "#572160"
    },
    {
      "class": "label_control",
      "fg": "#F8ECE0"
    },
    {
      "class": "label_control",
      "parents": [
        {
          "class": "status_bar"
        }
      ],
      "shadow_color": "transparent"
    },
    {
      "class": "vcs_branch_icon",
      "layer0.tint": "#CAABCF"
    },
    {
      "class": "vcs_changes_annotation",
      "color": "#CAABCF",
      "border_color": "#CAABCF"
    },
    {
      "class": "progress_bar_control",
      "layer0.tint": "#5F3466",
      "layer0.opacity": 1.0
    },
    {
      "class": "progress_gauge_control",
      "layer0.tint": "#F4D660",
      "layer0.opacity": 1.0
    },
    {
      "class": "overlay_control",
      "layer0.tint": "#531C5C"
    },
    {
      "class": "quick_panel",
      "layer0.tint": "#531C5C"
    },
    {
      "class": "quick_panel_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#374573",
      "layer0.opacity": 1.0
    },
    {
      "class": "mini_quick_panel_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#374573",
      "layer0.opacity": 1.0
    },
    {
      "class": "quick_panel_label",
      "fg": "#F8ECE0",
      "match_fg": "#80BDFB",
      "selected_fg": "#F8ECE0",
      "selected_match_fg": "#80BDFB"
    },
    {
      "class": "quick_panel_path_label",
      "fg": "#CAABCF",
      "match_fg": "#80BDFB",
      "selected_fg": "#F8ECE0",
      "selected_match_fg": "#80BDFB"
    },
    {
      "class": "quick_panel_label hint",
      "fg": "#CAABCF",
      "selected_fg": "#F8ECE0"
    },
    {
      "class": "auto_complete",
      "tint_modifier": "#531C5C"
    },
    {
      "class": "auto_complete_detail_pane",
      "tint_modifier": "#531C5C"
    },
    {
      "class": "table_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#374573",
      "layer0.opacity": 1.0
    },
    {
      "class": "tool_tip_control",
      "layer0.tint": "#531C5C"
    },
    {
      "class": "tool_tip_label_control",
      "fg": "#F8ECE0"
    },
    {
      "class": "dialog",
      "layer0.tint": "#531C5C"
    },
    {
      "class": "title_label_control",
      "fg": "#F8ECE0"
    },
    {
      "class": "link_label",
      "fg": "#89C8FE"
    }
  ]
}
