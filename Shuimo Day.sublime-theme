{
  "extends": "Adaptive.sublime-theme",
  "variables": {
    "sheet_dark_modifier": "blend(#DBD9D2 70%)",
    "sheet_medium_dark_modifier": "blend(#DBD9D2 70%)",
    "sheet_medium_modifier": "blend(#DBD9D2 70%)",
    "sheet_light_modifier": "blend(#DBD9D2 70%)",
    "text_widget_dark_modifier": "blend(#DBD9D2 70%)",
    "text_widget_light_modifier": "blend(#DBD9D2 70%)"
  },
  "rules": [
    {
      "class": "title_bar",
      "settings": [
        "themed_title_bar"
      ],
      "bg": "#DBD9D2",
      "fg": "#2A2A28",
      "style": "light"
    },
    {
      "class": "tabset_control",
      "settings": {
        "file_tab_style": [
          "",
          "rounded",
          "square"
        ]
      },
      "layer0.tint": "#DBD9D2"
    },
    {
      "class": "tab_control",
      "settings": {
        "file_tab_style": [
          "",
          "rounded",
          "square"
        ]
      },
      "layer0.tint": "#DBD9D2"
    },
    {
      "class": "tabset_control",
      "settings": {
        "file_tab_style": "angled"
      },
      "tint_modifier": "#DBD9D2"
    },
    {
      "class": "tab_label",
      "fg": "#615F59",
      "opacity": 1.0
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "hover"
          ]
        }
      ],
      "fg": "#2A2A28"
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "#2A2A28"
    },
    {
      "class": "grid_layout_control",
      "border_color": "#DBD9D2"
    },
    {
      "class": "status_bar",
      "layer0.tint": "#DBD9D2",
      "layer1.tint": "#D8D6CF"
    },
    {
      "class": "sidebar_container",
      "layer0.tint": "#DBD9D2",
      "layer0.opacity": 1.0
    },
    {
      "class": "tree_row",
      "attributes": [
        "selectable",
        "hover"
      ],
      "layer0.tint": "#E2E0DA",
      "layer0.opacity": 1.0
    },
    {
      "class": "tree_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#D9DEE3",
      "layer0.opacity": 1.0
    },
    {
      "class": "sidebar_heading",
      "fg": "#615F59",
      "shadow_color": "transparent"
    },
    {
      "class": "sidebar_label",
      "fg": "#2A2A28"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "file_system_entry",
          "attributes": [
            "ignored"
          ]
        }
      ],
      "fg": "#615F59"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "hover"
          ]
        }
      ],
      "fg": "#2A2A28"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "#2A2A28"
    },
    {
      "class": "panel_control",
      "layer0.tint": "#DBD9D2",
      "layer1.tint": "#D8D6CF"
    },
    {
      "class": "switch_project_panel_cancel_container",
      "layer0.tint": "#DBD9D2"
    },
    {
      "class": "label_control",
      "fg": "#2A2A28"
    },
    {
      "class": "label_control",
      "parents": [
        {
          "class": "status_bar"
        }
      ],
      "shadow_color": "transparent"
    },
    {
      "class": "vcs_branch_icon",
      "layer0.tint": "#615F59"
    },
    {
      "class": "vcs_changes_annotation",
      "color": "#615F59",
      "border_color": "#615F59"
    },
    {
      "class": "progress_bar_control",
      "layer0.tint": "#D8D6CF",
      "layer0.opacity": 1.0
    },
    {
      "class": "progress_gauge_control",
      "layer0.tint": "#B03A2E",
      "layer0.opacity": 1.0
    },
    {
      "class": "overlay_control",
      "layer0.tint": "#FAF9F6"
    },
    {
      "class": "quick_panel",
      "layer0.tint": "#FAF9F6"
    },
    {
      "class": "quick_panel_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#D9DEE3",
      "layer0.opacity": 1.0
    },
    {
      "class": "mini_quick_panel_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#D9DEE3",
      "layer0.opacity": 1.0
    },
    {
      "class": "quick_panel_label",
      "fg": "#2A2A28",
      "match_fg": "#3D5F7A",
      "selected_fg": "#2A2A28",
      "selected_match_fg": "#3D5F7A"
    },
    {
      "class": "quick_panel_path_label",
      "fg": "#615F59",
      "match_fg": "#3D5F7A",
      "selected_fg": "#2A2A28",
      "selected_match_fg": "#3D5F7A"
    },
    {
      "class": "quick_panel_label hint",
      "fg": "#615F59",
      "selected_fg": "#2A2A28"
    },
    {
      "class": "auto_complete",
      "tint_modifier": "#FAF9F6"
    },
    {
      "class": "auto_complete_detail_pane",
      "tint_modifier": "#FAF9F6"
    },
    {
      "class": "table_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#D9DEE3",
      "layer0.opacity": 1.0
    },
    {
      "class": "tool_tip_control",
      "layer0.tint": "#FAF9F6"
    },
    {
      "class": "tool_tip_label_control",
      "fg": "#2A2A28"
    },
    {
      "class": "dialog",
      "layer0.tint": "#FAF9F6"
    },
    {
      "class": "title_label_control",
      "fg": "#2A2A28"
    },
    {
      "class": "link_label",
      "fg": "#3D5F7A"
    }
  ]
}
