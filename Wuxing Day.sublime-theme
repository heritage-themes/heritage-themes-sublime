    {
      "class": "quick_panel_label",
      "fg": "#2B3040",
      "match_fg": "#2456B4",
      "selected_fg": "#2B3040",
      "selected_match_fg": "#2456B4"
    },
    {
      "class": "quick_panel_path_label",
      "fg": "#605C4E",
      "match_fg": "#2456B4",
      "selected_fg": "#2B3040",
      "selected_match_fg": "#2456B4"
    },
    {
      "class": "quick_panel_label hint",
      "fg": "#605C4E",
      "selected_fg": "#2B3040"
    },
    {
      "class": "auto_complete",
      "tint_modifier": "#FBF7EC"
    },
    {
      "class": "auto_complete_detail_pane",
      "tint_modifier": "#FBF7EC"
    },
    {
      "class": "table_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#D3DBEE",
      "layer0.opacity": 1.0
    },
    {
      "class": "tool_tip_control",
      "layer0.tint": "#FBF7EC"
    },
    {
      "class": "tool_tip_label_control",
      "fg": "#2B3040"
    },
    {
      "class": "dialog",
      "layer0.tint": "#FBF7EC"
    },
    {
      "class": "title_label_control",
      "fg": "#2B3040"
    },
    {
      "class": "link_label",
      "fg": "#2456B4"
    }
  ]
}
